{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keyprocess-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Unknown URLs get 404.html with a real 404 status instead of an empty page.
    "not_found_handling": "404-page"
  },
  // Emails audit form submissions. The destination must be a verified
  // address in Cloudflare Email Routing.
  "send_email": [
    { "name": "AUDIT_EMAIL", "destination_address": "keyprocessautomation@gmail.com" }
  ],
  // Lets Cloudflare build preview links for branches and pull requests.
  "previews": {}
}
